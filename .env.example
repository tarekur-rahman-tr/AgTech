# PostgreSQL connection string from your Neon project.
# Keep the real value in .env.local / deployment secrets; never commit it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Long, random secret used by Payload for authentication and sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET="replace-with-a-long-random-secret"

# First administrator bootstrap only. Put real values in .env.local, never here.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

# Optional: enables AI-assisted leaf diagnosis.
# Keep your API key private. Never use a NEXT_PUBLIC_ prefix for this key.
APP_GEMINI_API_KEY=
APP_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Optional: canonical public URL used for metadata and deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
